# Token del bot de Discord (obtenido en https://discord.com/developers/applications)
DISCORD_TOKEN=tu_token_aqui

# ID de la aplicación / cliente del bot
CLIENT_ID=tu_client_id_aqui

# Client Secret de Discord (obtenido en Discord Developer Portal > OAuth2) para el Dashboard Web
CLIENT_SECRET=tu_client_secret_aqui

# Puerto y URL del Dashboard Web & API
DASHBOARD_PORT=3000
DASHBOARD_URL=http://localhost:3000

# Ruta del archivo de base de datos SQLite (opcional, por defecto ./data/jarvis_security.db)
DATABASE_PATH=./data/jarvis_security.db

# Multi-Guild: El dueño de cada servidor se detecta automáticamente (guild.ownerId).
# Si deseas especificar IDs de desarrolladores globales del bot con bypass total, usa (opcional):
# DEVELOPER_IDS=id1,id2
